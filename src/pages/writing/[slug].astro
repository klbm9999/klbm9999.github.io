---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { profile } from '../../data/profile';

type Post = CollectionEntry<'writing'>;
type PublishedPost = Post & { data: Extract<Post['data'], { status: 'published' }> };

// Only published posts get a page; "coming soon" entries render on the home page without a link.
export const getStaticPaths = (async () => {
  const posts = await getCollection('writing', (post): post is PublishedPost => post.data.status === 'published');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: PublishedPost;
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.published.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={`${post.data.title} - ${profile.name}`} description={post.data.teaser}>
  <SiteHeader />
  <main id="main" class="wrap">
    <article class="post">
      <h1>{post.data.title}</h1>
      <p class="meta"><time datetime={post.data.published.toISOString().slice(0, 10)}>{date}</time></p>
      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
  <SiteFooter />
</Base>
